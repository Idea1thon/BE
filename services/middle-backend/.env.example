# 애플리케이션 환경변수 예시. 복사해서 .env 로 사용한다.
ENVIRONMENT=development

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://localhost:5432/fmp

# 인증 (D2: JWT Bearer Access Token + Refresh Token)
# 운영에서는 반드시 별도 값으로 교체한다. ENVIRONMENT != development 이면 기본값 사용 시 기동 실패.
JWT_SECRET=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 시드 전용 (scripts/seed.py)
SEED_PASSWORD=devpass1234

# CORS — FE Origin 목록. 쉼표 구분. `*`는 허용되지 않는다(설정 검증에서 거부).
# 개발: Vite dev server. 운영: 실제 FE 도메인을 명시한다.
#   예) CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173
