# 애플리케이션 환경변수 예시. 복사해서 .env 로 사용한다.
ENVIRONMENT=development

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://localhost:5432/fmp

# 인증 (D2: JWT Bearer Access Token + Refresh Token)
# 기본값이 없다. 모든 환경에서 필수이며 32자 이상이어야 한다. 값이 없으면 기동에 실패한다.
# 생성: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# 시드 전용 (scripts/seed.py). 필수 — 기본값 없음.
# seed는 ENVIRONMENT가 development/test일 때만 실행된다.
SEED_PASSWORD=devpass1234

# CORS — FE Origin 목록. 쉼표 구분. `*`는 허용되지 않는다(설정 검증에서 거부).
# 개발: Vite dev server. 운영: 실제 FE 도메인을 명시한다.
#   예) CORS_ALLOW_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ALLOW_ORIGINS=http://localhost:5173
