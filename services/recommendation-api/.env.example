# 추천 API 전용 환경파일
# 이 파일을 services/recommendation-api/.env 로 복사하고 값을 채운다.
# 중간 백엔드의 DATABASE_URL과 섞지 않는다.

DATABASE_URL=postgresql://ideaton:PASSWORD@127.0.0.1:55432/ideaton
INTERNAL_API_TOKEN=

# 대용량 원천 데이터가 서비스 외부 볼륨에 있을 때 지정한다.
# 비워 두면 로컬에서 data/ 디렉터리가 있는 저장소 경로를 자동 탐색한다.
RECOMMENDATION_DATA_ROOT=

RECOMMENDATION_QUARTER=20261
RECOMMENDATION_SOURCE=db
RECOMMENDATION_LLM_MODE=auto
RECOMMENDATION_DEFAULT_LIMIT=5
RECOMMENDATION_REQUEST_TIMEOUT_SECONDS=180
RECOMMENDATION_READINESS_TIMEOUT_SECONDS=3
RECOMMENDATION_MAX_CONCURRENT=4
RECOMMENDATION_INCLUDE_POI=false
RECOMMENDATION_INCLUDE_POI_CONTEXT=false
RECOMMENDATION_INCLUDE_NEWS=true
RECOMMENDATION_API_OUT_ROOT=output/recommendation_api_runs
CORS_ALLOW_ORIGINS=

# 선택: OpenAI-compatible endpoint
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=20
