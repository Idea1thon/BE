# 추천 API 전용 환경파일
# 이 파일을 services/recommendation-api/.env 로 복사하고 값을 채운다.
# 중간 백엔드의 DATABASE_URL과 섞지 않는다.

# 팀 공유 Azure PostgreSQL (ideaton DB, 계정 pipeline_app). SSL 필수.
#   접속 안 되면: (1) https://ifconfig.me 로 공인 IP 확인 → 철중에게 방화벽 등록 요청
#                (2) 서버 stop 상태일 수 있음 → 철중에게 start 요청
#   적재 범위: 서울 전체 25개 구 (2026-09-06 이관, DB ~2.9GB).
#   Azure 는 psql spawn 마다 SSL 핸드셰이크가 있어 콜드 요청이 느리다
#   (서빙 서버는 프로세스 캐시로 완화 — serving_db, SERVING_CACHE_TTL_SECONDS).
DATABASE_URL=postgresql://pipeline_app:PASSWORD@idea1thon-pg-d8f1.postgres.database.azure.com:5432/ideaton?sslmode=require
# 폴백(로컬 Docker): postgresql://ideaton:PASSWORD@127.0.0.1:55432/ideaton
INTERNAL_API_TOKEN=

# 대용량 원천 데이터가 서비스 외부 볼륨에 있을 때 지정한다.
# 비워 두면 로컬에서 data/ 디렉터리가 있는 저장소 경로를 자동 탐색한다.
RECOMMENDATION_DATA_ROOT=

RECOMMENDATION_QUARTER=20261
RECOMMENDATION_SOURCE=db
RECOMMENDATION_LLM_MODE=auto
# buildings: 건축물대장 개별 건물 centroid를 기본 seed로 사용
# anchors: 기존 역·아파트·POI·생성지점 seed만 사용
# hybrid: 기존 anchor와 건물 seed를 함께 사용
RECOMMENDATION_SEED_MODE=buildings
RECOMMENDATION_DEFAULT_LIMIT=5
RECOMMENDATION_REQUEST_TIMEOUT_SECONDS=180
RECOMMENDATION_READINESS_TIMEOUT_SECONDS=3
RECOMMENDATION_MAX_CONCURRENT=4
# 동시 실행 슬롯이 가득 찼을 때 중간 백엔드가 재시도할 권장 대기 시간
RECOMMENDATION_CAPACITY_RETRY_AFTER_SECONDS=10
RECOMMENDATION_INCLUDE_POI=false
RECOMMENDATION_INCLUDE_POI_CONTEXT=false
RECOMMENDATION_INCLUDE_NEWS=true
RECOMMENDATION_API_OUT_ROOT=output/recommendation_api_runs
CORS_ALLOW_ORIGINS=

# 선택: OpenAI-compatible endpoint
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=20
