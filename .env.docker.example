# Docker 팀 공유용 PostgreSQL + PostGIS + pgvector 설정
# 이 파일을 .env.docker 로 복사한 뒤 강한 비밀번호를 직접 입력한다.

POSTGRES_DB=ideaton
POSTGRES_USER=ideaton
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# Postgres.app이 호스트 5432를 사용하므로 Docker는 55432로 공개한다.
# 같은 LAN/VPN의 팀원이 접근할 때만 0.0.0.0을 사용한다.
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_HOST_PORT=55432

# 컨테이너 내부 초기화
POSTGRES_INITDB_ARGS=--encoding=UTF8 --locale=C.UTF-8
