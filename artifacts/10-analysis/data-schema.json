  "canonical_tables": {
    "area_dim": {
      "primary_key": ["spatial_unit_type", "spatial_unit_code"],
      "required": ["area_id", "spatial_unit_type", "spatial_unit_code", "spatial_unit_name", "geometry_path", "crs"],
      "crs": "EPSG:5181"
    },
    "industry_dim": {
      "primary_key": ["industry_code"],
      "required": ["industry_code", "industry_name", "boundary_note", "ontology_version"],
      "reference_path": "data/ontology/업종_검색키워드.json"
    },
    "metric_quarter": {
      "logical_key": ["period", "spatial_unit_type", "spatial_unit_code", "industry_code", "metric_name"],
      "required": ["period", "period_type", "spatial_unit_type", "spatial_unit_code", "metric_name", "value", "unit", "source_path", "source_column", "source_type"],
      "period_type": "quarter"
    },
    "background_snapshot": {
      "logical_key": ["period", "spatial_unit_type", "spatial_unit_code", "metric_name"],
      "required": ["period", "period_type", "spatial_unit_type", "spatial_unit_code", "metric_name", "value", "source_path", "source_type", "grain_is_proxy"]
    },
    "anchor_point": {
      "primary_key": ["anchor_id"],
      "required": ["anchor_id", "anchor_type", "place_name", "source_path", "source_type", "observed_at", "synthetic_anchor", "coordinate_confidence"],
      "coordinate_fields": ["x_wgs84", "y_wgs84", "x_5181", "y_5181"]
    },
    "poi_snapshot": {
      "primary_key": ["source", "poi_id", "retrieved_at_utc"],
      "required": ["source", "source_type", "poi_id", "place_name", "category_group_code", "x_wgs84", "y_wgs84", "search_mode", "retrieved_at_utc"]
    },
    "plan_snapshot": {
      "required": ["source_path", "source_type", "observed_at", "spatial_unit_type", "status_note"],
      "status_rule": "사업·계획 상태는 snapshot으로만 표현하고 미래 성공·확정 사건으로 승격하지 않음"
    },
    "news_snapshot": {
      "primary_key": ["source", "news_id"],
      "required": ["source", "source_type", "news_id", "published_date", "title", "url", "query_label", "search_period"],
      "body_retained": false,
      "usage": "FC-51-news evidence/context_notes only"
    },
    "candidate_evidence": {
      "schema_path": "artifacts/20-method/rag-evidence-schema.json",
      "candidate_is_success_probability": false
    }
  },
