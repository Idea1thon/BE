# docker-compose 용. 복사해서 .env 로 쓴다. 값이 없으면 compose 의 개발용
# 기본값이 적용되므로, 그대로 `docker compose up --build` 해도 뜬다.
#
# 이 파일에 Azure 접속 정보를 넣지 않는다. 서비스별 .env 도 마찬가지다.

POSTGRES_PASSWORD=devpass

# 32자 이상. 개발 기본값이 있으나 각자 바꿔 쓰는 편이 낫다.
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

SEED_PASSWORD=devpass1234
CORS_ALLOW_ORIGINS=http://localhost:5173

# 중간 백엔드 → 추천 API 서버 간 호출 토큰. 양쪽이 같은 값을 써야 한다.
INTERNAL_API_TOKEN=

# Siren read-only source databases (local Docker compose).
# The Siren process resolves branch reports in FMP and location/market facts in
# IDEATON; middle-backend only sends the ID-only analysis trigger.
SIREN_FMP_DATABASE_URL=postgresql+asyncpg://postgres:devpass@127.0.0.1:55432/fmp
SIREN_IDEATON_DATABASE_URL=postgresql+asyncpg://postgres:devpass@127.0.0.1:55432/ideaton
# Optional approved FMP table/view with annual brand closure aggregates.
# If absent or not found, franchise_closure is returned as missing.
SIREN_FRANCHISE_CLOSURE_TABLE=public.franchise_closure_year
SIREN_COMPETITION_RADIUS_M=250
SIREN_SIMILAR_INDUSTRIES_JSON=[]

# 원천 CSV 를 가진 사람만 채운다. 저장소에는 없다.
# 예) RECOMMENDATION_DATA_ROOT=/data/idea1thon
RECOMMENDATION_DATA_ROOT=
