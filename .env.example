# API 키 템플릿. 이 파일을 .env 로 복사하고 값만 채운다.
#   cp .env.example .env
# .env 는 .gitignore 대상이라 커밋되지 않는다. 실제 키를 .env.example 에 넣지 말 것.
# 스크립트에서는 scripts/_env.py 의 load_env() 로 읽는다.

# ─────────────────────────────────────────────────────────────
# 원천 데이터 위치 (선택)
# ─────────────────────────────────────────────────────────────

# 이식 스크립트가 읽는 원천 데이터 루트. 비우면 ~/Documents/서울창업입지_원천데이터
#   외국인생활인구/ · 식품인허가/ · 고용률/ · 도시계획사업/ · 임대동향/ · 도시철도역사/ ·
#   버스정류장/ · 공동주택/  하위 폴더 구조를 기대.
# RAW_DATA_DIR=

# ─────────────────────────────────────────────────────────────
# 활성 (현재 사용)
# ─────────────────────────────────────────────────────────────

# VWorld(브이월드) 지오코딩 API — 국토교통부/국가공간정보센터. 단일 key 로 양방향.
#   주소 → 좌표 : https://api.vworld.kr/req/address?service=address&request=getCoord&key=KEY&...
#   좌표 → 주소 : https://api.vworld.kr/req/address?service=address&request=getAddress&key=KEY&...
#   용도: rag-evidence-schema.json 의 location.address_point (reverse_geocode / geocode)
#   발급: https://www.vworld.kr/dev/v4dv_apikey_s001.do (또는 공공데이터포털 15101106)
#   일 40,000건 한도, 실시간 사용만(DB 영구 저장 금지). 키 발급 시 등록한 도메인/IP 에서만 호출됨.
#   같은 키로 VWorld 데이터 API(건물·필지 등)·지도 API 도 사용 가능.
VWORLD_API_KEY=

# 행정안전부 도로명주소 좌표제공 팝업 API — 주소 검색 결과의 UTM-K 좌표(entX/entY).
#   신청 페이지: https://business.juso.go.kr/jst/jstCoordApiPop
#   호출 URL: https://business.juso.go.kr/addrlink/addrCoordUrl.do
#   좌표제공 API용 승인키(confmKey)는 검색 API 승인키와 별도이며,
#   배포 URL 또는 호출 IP를 등록한 뒤 발급받는다. 현재 프로젝트는 배포 전이라 미발급.
# JUSO_COORD_API_KEY=

# ─────────────────────────────────────────────────────────────
# PostgreSQL + PostGIS — 서빙 파이프라인·이식 스크립트 공용 저장소
# ─────────────────────────────────────────────────────────────

# recommendation_pipeline.py 는 기본값 --source db 로 이 DB에서 모든 입력을 읽는다
# (영역 폴리곤·분기 팩트·seed·반경·네이버·뉴스·임대료). --source db 는 원천 데이터
# 파일이 필요 없다. --source files 는 원천 CSV/shp 로 DB 없이 실행(A/B·개발용).
#
# 표준 대상 = compose.yaml 의 Docker 컨테이너(ideaton-db). `docker compose up -d db`.
# 비밀번호는 .env.docker 의 POSTGRES_PASSWORD 와 동일해야 한다. 실제 값은 .env 에만.
# DATABASE_URL=postgresql://ideaton:PASSWORD@127.0.0.1:55432/ideaton
#
# 폴백(레거시): DATABASE_URL 이 비어 있으면 아래 개별 값으로 접속.
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_DB=ideaton
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_SCHEMA=location
# POSTGRES_SSLMODE=prefer

# 네이버 데이터랩 검색어 트렌드 API — 프로파일 FC-41·42 (지역명·업종명 검색 관심도 추세).
#   2025년 검색/데이터랩 API가 NAVER API HUB(네이버 클라우드)로 이관됨.
#   신규 엔드포인트: POST https://naverapihub.apigw.ntruss.com/search-trend/v1/search
#   신규 헤더: X-NCP-APIGW-API-KEY-ID (= Client ID) / X-NCP-APIGW-API-KEY (= Client Secret)
#   → scripts/naver_datalab.py 가 신규(NCP)·레거시 엔드포인트를 순서대로 시도하므로
#     아래 두 값에 애플리케이션의 Client ID / Client Secret 을 그대로 넣으면 됨.
#   반환값은 요청 구간 내 상대지수(0~100), 절대 검색량·지역별 분해 없음.
#   무료 구간 = 월 30,000건. NAVER_DATALAB_MONTHLY_LIMIT(기본 28000) 초과 시 자동 중단.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# NAVER_DATALAB_MONTHLY_LIMIT=28000
# NAVER_DATALAB_ENDPOINTS=https://naverapihub.apigw.ntruss.com/search-trend/v1/search,https://openapi.naver.com/v1/datalab/search
# 네이버 뉴스 API HUB — 현재 시점 수동 snapshot 수집 전용
#   파이프라인은 API를 호출하지 않으며 자동화·예약 갱신하지 않음.
#   수집 스크립트: scripts/ingest_naver_news_snapshot.py
# NAVER_NEWS_ENDPOINT=https://naverapihub.apigw.ntruss.com/search/v1/news
# NAVER_NEWS_MONTHLY_LIMIT=24000
# NAVER_NEWS_DAILY_LIMIT=24000
# NAVER_NEWS_PER_RUN_LIMIT=50

# 공공데이터포털(data.go.kr) 일반 인증키 — 계정당 1개(단일 키), 모든 활용신청 API 공용.
#   용도: 국토교통부 공동주택 단지 목록 제공 서비스(15057332) — 단지코드·단지명 조회.
#         (좌표 미제공 → 단지 주소를 VWORLD_API_KEY 로 지오코딩)
#         아파트 단지 앵커(nearby_anchors). 면적(15073269)·GIS건물통합정보(서울)는 파일로 확보됨.
#   신청: https://www.data.go.kr/data/15057332/openapi.do → "활용신청"(자동승인, 즉시).
#   엔드포인트: https://apis.data.go.kr/1613000/AptListService4
#     /getSidoAptList4 (시도코드)  /getSigunguAptList4 (시군구코드)
#     /getLegaldongAptList4 (법정동코드)  /getRoadnameAptList4 (도로명코드)  /getTotalAptList4 (전국)
#     → 응답: kaptCode(단지코드)·kaptName(단지명). 일일 트래픽 5,000/기능.
#     상세 주소·동수·세대수는 공동주택 기본정보 서비스(15058453)에서 kaptCode 로 조회.
#   키에 +, /, = 가 들어가면 requests 는 params= 에 넣고(자동 URL 인코딩),
#     이미 인코딩된 키를 받았다면 그대로 문자열로 붙일 것. (SERVICE_KEY_IS_NOT_REGISTERED_ERROR 시 반대로)
#   scripts/ingest_apartment_complex.py(예정)가 사용.
DATA_GO_KR_SERVICE_KEY=

# 한국부동산원 R-ONE 부동산통계정보 Open API.
#   용도: 상업용부동산 임대료·임대가격지수·공실률 갱신 보조
#         (프로파일 FC-20·FC-21; 현재 저장소에는 CSV 스냅샷도 보존됨).
#   실제 사용 시 scripts/_env.py 의 require("RONE_API_KEY") 로 읽는다.
#   키 값은 .env에만 입력하고 이 파일에는 남기지 않는다.
RONE_API_KEY=

# ─────────────────────────────────────────────────────────────
# 추가 연동 (카카오맵 이식 예정)
# ─────────────────────────────────────────────────────────────

# LLM 입력 해석·분석 계획·Evidence 설명 생성 — OpenAI-compatible hosted endpoint.
#   비워두면 recommendation_pipeline.py --llm-mode auto가 결정론적 입력 파서·템플릿으로 폴백한다.
#   실제 API 호출은 LLM_API_URL·LLM_API_KEY·LLM_MODEL이 모두 있을 때만 발생한다.
#   예: LLM_API_URL=https://provider.example/v1
#   원천 CSV/raw/개인정보를 보내지 않고 선택 지역·구조화 Evidence만 전달한다.
# LLM_API_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_TIMEOUT_SECONDS=20
# LLM_MAX_OUTPUT_TOKENS=1200

# 카카오 로컬 REST API — 상가·근린생활시설 POI 검색 및 좌표→주소 변환.
#   용도: 후보 seed 확장, 상가·근생 POI, 도로명주소 보조
#   발급: https://developers.kakao.com → 내 애플리케이션 → 앱 키 → REST API 키
#   인증: Authorization: KakaoAK ${KAKAO_REST_API_KEY}
#   실제 사용 시 scripts/_env.py 의 require("KAKAO_REST_API_KEY") 로 읽는다.
KAKAO_REST_API_KEY=

# Kakao Local 호출 예산 가드 (2026-09-02 공식 무료 쿼터 확인).
#   공식: 키워드/카테고리 검색 각각 일 100,000건, 전체 API 월 3,000,000건.
#   기본값은 안전 버퍼(일 90,000·월 2,700,000). 이 범위를 초과하는 값은 코드가 거부한다.
#   실제 HTTP 시도(재시도·HTTP 오류 포함)를 .api_budget.json에 보수적으로 기록한다.
KAKAO_LOCAL_DAILY_LIMIT=90000
KAKAO_LOCAL_MONTHLY_LIMIT=2700000
KAKAO_LOCAL_PER_RUN_LIMIT=500

# 카카오맵 JavaScript API — 웹 화면에서 지도 타일·마커를 표시할 때만 사용.
#   REST API 키와 별도 앱 키이며, 백엔드 POI 이식에는 필요하지 않다.
# KAKAO_JAVASCRIPT_KEY=

# ─────────────────────────────────────────────────────────────
# 미사용 (이식 슬롯 활성화 시 필요, data-acquisition-sources.md 참조)
# ─────────────────────────────────────────────────────────────

# 서울 열린데이터광장 OpenAPI 인증키 — 생활인구/지하철 등 (대부분 파일 다운로드로 대체 가능).
#   sample 키로도 최근 2개월·소량은 테스트 가능. https://data.seoul.go.kr/together/mypage/actKey.do
# SEOUL_OPENAPI_KEY=

# 빅카인즈(BIGKINDS) 뉴스 API — FC-41·42 뉴스 언급량. 한국언론진흥재단 신청.
# BIGKINDS_API_KEY=

# KOSIS 국가통계포털 OpenAPI — FC-53 자치구별 고용률. https://kosis.kr/openapi/
# KOSIS_API_KEY=
