  "storage_targets": {
    "local_source": {
      "engine": "postgresql",
      "server_version": "18.4",
      "host": "127.0.0.1",
      "port": 5432,
      "database": "ideaton",
      "role": "personal_source_and_validation",
      "remote_access": false,
      "password_documented": false
    },
    "docker_team_mirror": {
      "engine": "postgresql",
      "server_version": "16.14",
      "host": "<docker_host_lan_or_vpn_ip>",
      "port": 55432,
      "database": "ideaton",
      "role": "team_shared_read_and_development",
      "extensions": ["postgis", "vector"],
      "persistent_volume": "ideaton_pgdata",
      "auto_sync_with_local_source": false,
      "remote_access": "trusted_lan_or_vpn_only",
      "password_documented": false
    }
  },
  "spatial_unit_types": [
    "commercial_area",
    "hinterland",
    "admin_dong",
    "sigungu",
    "region",
    "point"
