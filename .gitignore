# 전량 적재 완료·검증됨(2026-09-05), 저장소엔 불필요. manifest_*.json(가벼운 커버리지 요약)만 커밋 유지.
# 재생성: .venv/bin/python3 scripts/ingest_building_register.py --all
data/건축물대장/api/*.csv


